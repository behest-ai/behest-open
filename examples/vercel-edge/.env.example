# ─── NextAuth ────────────────────────────────────────────────────────────────
# A random secret used to sign login cookies.
# Generate one with: openssl rand -base64 32
AUTH_SECRET=replace_with_random_string

# ─── Behest ──────────────────────────────────────────────────────────────────
# Your Behest API key — kept server-side only, never sent to the browser.
# Found in: Behest dashboard → Project → API Keys
BEHEST_KEY=behest_sk_live_xxxxxxxxxxxxxxxx

# The base URL of your Behest project.
# Found in: Behest dashboard → Project → Settings
BEHEST_BASE_URL=https://your-slug.behest.app

# Same URL as above — the NEXT_PUBLIC_ prefix makes it readable by the browser.
# Safe to expose: it's just an address, not a secret.
NEXT_PUBLIC_BEHEST_BASE_URL=https://your-slug.behest.app
