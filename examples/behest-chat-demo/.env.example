# Behest Chat Demo — Environment Configuration Template
# Copy this file to .env.local and update with your values

# Your private Behest API key
# Get this from: https://dashboard.behest.ai
BEHEST_API_KEY=behest_sk_live_xxx

# Behest API endpoint
# Get your project domain from: https://dashboard.behest.ai → Projects → Your Project → Integration Guide
# Format: https://your-project-name.behest.app (replace 'your-project-name' with your actual project domain)
BEHEST_BASE_URL=https://your-project-name.behest.app

# Optional: Chat endpoint (defaults to BEHEST_BASE_URL)
# BEHEST_CHAT_URL=https://your-project-name.behest.app

# Server port
PORT=3080

# Node environment
NODE_ENV=development

# Secret for signing session cookies (use a strong random string in production)
SESSION_SECRET=local-dev-secret-change-me-in-production

# Allowed CORS origins (comma-separated for multiple)
CORS_ORIGIN=http://localhost:3080

# Logging level
LOG_LEVEL=debug
