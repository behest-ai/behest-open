{
  "name": "@behest/client-ts",
  "version": "1.5.0-beta.1",
  "description": "Behest Client Library for TypeScript/Node.js — dual-mode (API key or local sign), auth.mint, chat completions with streaming, threads, usage, typed errors.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest",
    "lint": "eslint src/**"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/behest-ai/behest-open.git",
    "directory": "packages/client-ts"
  },
  "homepage": "https://github.com/behest-ai/behest-open/tree/main/packages/client-ts#readme",
  "bugs": {
    "url": "https://github.com/behest-ai/behest-open/issues"
  },
  "keywords": [
    "behest",
    "openai",
    "client",
    "sdk"
  ],
  "author": "Behest",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.19.33",
    "eslint": "^8.0.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^1.6.1"
  },
  "dependencies": {
    "jose": "^6.2.2",
    "openai": "^4.0.0"
  },
  "peerDependencies": {
    "openai": "^4.0.0"
  }
}
