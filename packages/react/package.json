{
  "name": "@behest/react",
  "version": "1.5.0-beta.1",
  "description": "React hooks for Behest — browser-safe chat, threads, and session memory via a user-minted JWT. No Behest key ever in the browser.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/**"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/behest-ai/behest-open.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/behest-ai/behest-open/tree/main/packages/react#readme",
  "bugs": {
    "url": "https://github.com/behest-ai/behest-open/issues"
  },
  "keywords": [
    "behest",
    "react",
    "hooks",
    "chat",
    "openai",
    "streaming"
  ],
  "author": "Behest",
  "license": "MIT",
  "devDependencies": {
    "@testing-library/react": "^14.3.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "happy-dom": "^15.11.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^1.6.1"
  },
  "peerDependencies": {
    "openai": "^4.0.0",
    "react": ">=18"
  },
  "dependencies": {}
}
